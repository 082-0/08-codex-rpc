{
  "name": "eight-codex-rpc",
  "version": "1.1.0",
  "private": true,
  "description": "08 Discord Rich Presence for Codex Desktop and CLI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "build:linux": "electron-builder --linux --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.eight.codexrpc",
    "productName": "08 Codex RPC",
    "artifactName": "08-Codex-RPC-${version}-portable.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/08.ico",
      "target": "portable",
      "artifactName": "08-Codex-RPC-${version}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/08.png",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "08-Codex-RPC-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "icon": "assets/08.png",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "08-Codex-RPC-${version}-linux-${arch}.${ext}",
      "executableName": "08-codex-rpc"
    }
  },
  "author": {
    "name": "08",
    "url": "https://github.com/082-0"
  },
  "homepage": "https://github.com/082-0/08-codex-rpc",
  "repository": {
    "type": "git",
    "url": "https://github.com/082-0/08-codex-rpc.git"
  }
}
